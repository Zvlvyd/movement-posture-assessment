classDiagram
    class CameraView {
        +startCamera()
        +captureFrame()
        +drawSkeleton()
    }
    class FMSReportPanel {
        +showRadarChart()
        +showTags()
        +showCompare()
    }
    class PrescriptionFlow {
        +showPlan()
        +showProgress()
        +handleUnlock()
    }

    class PoseAnalyzer {
        -int smoothing
        +filterKeypoints()
        +calcAngles()
    }
    class ActionRecognizer {
        -dict fsm_states
        -dict rules
        +recognize()
        +getPhase()
    }
    class FMSScorer {
        -dict weights
        -dict thresholds
        +scoreDim()
        +genRadar()
    }
    class PrescriptionEngine {
        -dict mapping
        -dict templates
        +matchTags()
        +buildPlan()
    }
    class DualScorer {
        -enum mode
        +scoreBasic()
        +scoreComp()
    }
    class CorrectionEngine {
        -float limit
        -int cooldown
        +checkDeviation()
        +speakFeedback()
    }
    class CycleAdapter {
        -int cycleLen
        +getPhase()
        +adjustPlan()
    }
    class LockManager {
        -set unlocked
        +canUnlock()
        +doUnlock()
    }

    class User {
        -int id
        -str username
        -enum role
        -bool fms_completed
    }
    class TrainingRecord {
        -int action_id
        -enum mode
        -int score
        -json key_angles
    }
    class FMSRecord {
        -int balance
        -int squat
        -int flex
        -int stab
        -int symmetry
        -json problem_tags
    }
    class Prescription {
        -json warmup
        -json strengthen
        -json main
        -json cooldown
        -bool is_active
    }
    class Action {
        -str name
        -str category
        -int difficulty
        -json risk_tags
        -json standard_angles
    }
    class ProblemTag {
        -str tag_name
        -str description
        -str fms_dimension
    }

    class InvalidAngleException {
        +str dim
        +float value
    }
    class HighRiskLockException {
        +int action_id
        +str risk_level
    }
    class FSMStateException {
        +str expected
        +str actual
    }

    CameraView --> PoseAnalyzer : 调用
    FMSReportPanel --> FMSScorer : 调用
    PrescriptionFlow --> PrescriptionEngine : 调用
    PoseAnalyzer --> ActionRecognizer : 依赖
    ActionRecognizer --> FMSScorer : 依赖
    ActionRecognizer --> DualScorer : 依赖
    DualScorer --> CorrectionEngine : 依赖
    FMSScorer --> PrescriptionEngine : 依赖
    PrescriptionEngine --> LockManager : 依赖
    PrescriptionEngine --> CycleAdapter : 依赖
