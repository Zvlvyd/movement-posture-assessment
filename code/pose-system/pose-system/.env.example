# ============================================================
# 运动姿态评估与纠错系统 — 环境变量配置模板
# 使用方法：复制此文件为 .env，按需修改后启动后端
#   cp .env.example .env
# ============================================================

# ── 数据库（必填，如使用 SQLite 则无需设置密码）───────────
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=pose_correction

# ── 服务端口 ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8002

# ── JWT 密钥（必填，生成命令: openssl rand -hex 32）───────
SECRET_KEY=your-secret-key-change-me

# ── 默认账号（必填，后端首次启动时自动创建）───────────────
# 如果不设置密码，系统将自动生成随机密码并打印到控制台
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_admin
DEFAULT_COACH_USERNAME=coach
DEFAULT_COACH_PASSWORD=change_me_coach

# ── YOLO 模型路径 ─────────────────────────────────────────
MODEL_PATH=yolov8s-pose.pt
DEVICE=auto

# ── DeepSeek AI 报告（可选，如需 AI 处方功能请填写）────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 多浏览器访问（其他人通过网页访问你的电脑时开启）────────
CORS_ALLOW_LAN=true

# 如需手动追加额外来源（例如手机、平板等），逗号分隔：
# CORS_EXTRA_ORIGINS=http://192.168.1.100:5173,http://10.0.0.5:5173

# ── 测试端点（仅开发环境开启）────────────────────────────
# ENABLE_TEST_ENDPOINTS=true
