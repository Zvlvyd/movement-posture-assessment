# ============================================================
# 运动姿态评估与纠错系统 — 环境变量配置模板
# 使用方法：复制此文件为 .env，按需修改后启动后端
#   cp .env.example .env
# ============================================================

# ── 数据库（默认连本机 MySQL，多机时不需改此项）────────────
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=pose_correction

# ── 服务端口 ──────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8002

# ── JWT 密钥（生产环境请改为随机字符串）──────────────────
# SECRET_KEY=pose-correction-secret-key-2026

# ── 默认账号（后端首次启动时自动创建）────────────────────
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_COACH_USERNAME=coach
# DEFAULT_COACH_PASSWORD=coach123

# ── YOLO 模型路径 ─────────────────────────────────────────
# MODEL_PATH=yolov8s-pose.pt
# DEVICE=auto

# ── DeepSeek AI 报告 ──────────────────────────────────────
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# ── 多浏览器访问（其他人通过网页访问你的电脑时开启）────────
# 开启后自动将本机局域网 IP 加入 CORS 白名单，
# 局域网内其他电脑可通过 http://<你的IP>:5173 直接访问前端
CORS_ALLOW_LAN=true

# 如需手动追加额外来源（例如手机、平板等），逗号分隔：
# CORS_EXTRA_ORIGINS=http://192.168.1.100:5173,http://10.0.0.5:5173
