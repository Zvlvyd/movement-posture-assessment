from sqlalchemy.orm import Session
from fastapi import HTTPException
from typing import Optional, List
from backend.database import models
from models.fms.scoring import FMSScoringEngine
from models.fms.radar_report import RadarReport
from models.fms.problem_tagger import ProblemTagger
from backend.schemas.business import FMSSubmitRequest, FMSResultResponse

class FMSService:
    def __init__(self, db: Session):
        self.db = db
        self.engine = FMSScoringEngine()

    def process_screening(self, user_id: int, data: FMSSubmitRequest):
        scores = []
        if data.balance_duration is not None:
            scores.append(self.engine.score_balance(data.balance_duration))
        if data.flexibility_depth is not None:
            scores.append(self.engine.score_flexibility(data.flexibility_depth, data.flexibility_trunk or 0, data.flexibility_arm or 1.0))
        if data.upper_limb_distance is not None:
            scores.append(self.engine.score_upper_limb(data.upper_limb_distance))
        if data.core_duration is not None:
            scores.append(self.engine.score_core(data.core_duration))
        if data.symmetry_left is not None and data.symmetry_right is not None:
            scores.append(self.engine.score_symmetry(data.symmetry_left, data.symmetry_right))
        overall = self.engine.compute_overall(scores)
        risk_level = self.engine.get_risk_level(overall, scores)
        record = models.FMSRecord(user_id=user_id, balance_score=next((s.score for s in scores if s.dimension == "balance"), None), flexibility_score=next((s.score for s in scores if s.dimension == "flexibility"), None), upper_limb_score=next((s.score for s in scores if s.dimension == "upper_limb"), None), core_score=next((s.score for s in scores if s.dimension == "core"), None), symmetry_score=next((s.score for s in scores if s.dimension == "symmetry"), None), overall_score=overall, risk_level=risk_level)
        self.db.add(record); self.db.commit(); self.db.refresh(record)
        radar = RadarReport.generate(scores, overall, risk_level)
        tags = ProblemTagger.tag(scores)
        result = FMSResultResponse.model_validate(record)
        result.radar_data = radar; result.problem_tags = tags
        return result

    def get_user_records(self, user_id: int):
        return self.db.query(models.FMSRecord).filter(models.FMSRecord.user_id == user_id).order_by(models.FMSRecord.test_date.desc()).all()

    def get_record_detail(self, record_id: int, user_id: int):
        record = self.db.query(models.FMSRecord).filter(models.FMSRecord.id == record_id, models.FMSRecord.user_id == user_id).first()
        if not record: raise HTTPException(status_code=404, detail="Record not found")
        return FMSResultResponse.model_validate(record)

import json, math, time
from typing import Dict, List, Optional, Any
from fastapi import WebSocket
from sqlalchemy.orm import Session
from datetime import datetime
import numpy as np

from backend.database import models
from backend.services.fms_service import FMSService
from backend.schemas.business import FMSSubmitRequest
from models.fms.scoring import FMSScoringEngine
from models.angle_calculator import AngleCalculator

class RealtimeFMSService:
    def __init__(self, db: Session):
        self.db = db
        self.angle_calc = AngleCalculator()
        self.engine = FMSScoringEngine()

    async def handle_session(self, ws: WebSocket, user_id: int):
        await ws.accept()
        state = FMSState()
        try:
            while True:
                raw = await ws.receive_text()
                msg = json.loads(raw)
                msg_type = msg.get('type')

                if msg_type == 'start':
                    state.reset()
                    state.current_test_idx = 0
                    state.tests[0]['status'] = 'ready'
                    await ws.send_json({
                        'type': 'test_ready',
                        'test': state.current_test_idx,
                        'name': state.tests[0]['name'],
                        'instruction': state.tests[0]['instruction'],
                        'total_tests': len(state.tests)
                    })

                elif msg_type == 'frame':
                    test = state.current_test()
                    if not test or test['status'] == 'done':
                        continue

                    keypoints_data = msg.get('keypoints', [])
                    if not keypoints_data:
                        await ws.send_json({'type': 'frame_result', 'status': 'no_keypoints'})
                        continue

                    kp = np.array(keypoints_data, dtype=np.float32)
                    angles = self.angle_calc.compute_all_angles(kp)
                    state.last_angles = angles
                    state.frame_count += 1

                    result = {
                        'type': 'frame_result',
                        'test_idx': state.current_test_idx,
                        'angles': {k: round(v, 1) for k, v in angles.items() if v is not None},
                        'test_name': test['name'],
                    }

                    if state.current_test_idx == 0:  # Balance - eyes closed stand
                        result.update(self._eval_balance(state, angles))
                    elif state.current_test_idx == 1:  # Overhead squat
                        result.update(self._eval_flexibility(state, angles))
                    elif state.current_test_idx == 2:  # Shoulder mobility
                        result.update(self._eval_upper_limb(state, angles))
                    elif state.current_test_idx == 3:  # Plank
                        result.update(self._eval_core(state, angles))
                    elif state.current_test_idx == 4:  # Lunge symmetry
                        result.update(self._eval_symmetry(state, angles))

                    if test.get('completed'):
                        result['test_completed'] = True
                        result['test_score'] = test.get('score', 0)

                    await ws.send_json(result)

                elif msg_type == 'next_test':
                    if state.current_test_idx < len(state.tests) - 1:
                        state.current_test_idx += 1
                        state.tests[state.current_test_idx]['status'] = 'ready'
                        await ws.send_json({
                            'type': 'test_ready',
                            'test': state.current_test_idx,
                            'name': state.tests[state.current_test_idx]['name'],
                            'instruction': state.tests[state.current_test_idx]['instruction'],
                            'total_tests': len(state.tests)
                        })
                    else:
                        # All tests done - compute and save results
                        await ws.send_json({'type': 'all_tests_complete'})

                elif msg_type == 'finish':
                    scores = []
                    for test in state.tests:
                        if test['data']:
                            data = test['data']
                            if test['idx'] == 0:
                                scores.append(self.engine.score_balance(data.get('duration', 0)))
                            elif test['idx'] == 1:
                                scores.append(self.engine.score_flexibility(
                                    data.get('depth_angle', 90), data.get('trunk_tilt', 20), data.get('arm_maintained', 0.8)))
                            elif test['idx'] == 2:
                                scores.append(self.engine.score_upper_limb(data.get('hand_distance', 20)))
                            elif test['idx'] == 3:
                                scores.append(self.engine.score_core(data.get('duration', 0)))
                            elif test['idx'] == 4:
                                scores.append(self.engine.score_symmetry(data.get('left_score', 50), data.get('right_score', 50)))

                    if scores:
                        from models.fms.radar_report import RadarReport
                        from models.fms.problem_tagger import ProblemTagger
                        overall = self.engine.compute_overall(scores)
                        risk = self.engine.get_risk_level(overall, scores)
                        radar = RadarReport.generate(scores, overall, risk)
                        tags = ProblemTagger.tag(scores)

                        record = models.FMSRecord(
                            user_id=user_id,
                            balance_score=next((s.score for s in scores if s.dimension == 'balance'), None),
                            flexibility_score=next((s.score for s in scores if s.dimension == 'flexibility'), None),
                            upper_limb_score=next((s.score for s in scores if s.dimension == 'upper_limb'), None),
                            core_score=next((s.score for s in scores if s.dimension == 'core'), None),
                            symmetry_score=next((s.score for s in scores if s.dimension == 'symmetry'), None),
                            overall_score=overall,
                            risk_level=risk,
                        )
                        self.db.add(record)
                        self.db.commit()
                        self.db.refresh(record)

                        from backend.schemas.business import FMSResultResponse
                        result = FMSResultResponse.model_validate(record)
                        result.radar_data = radar
                        result.problem_tags = tags
                        await ws.send_json({
                            'type': 'fms_result',
                            'record_id': record.id,
                            'overall_score': overall,
                            'risk_level': risk,
                            'radar_data': radar,
                            'problem_tags': tags,
                            'scores': [{'dimension': s.dimension, 'score': round(s.score, 1), 'label': s.label} for s in scores]
                        })
                    break

        except Exception as e:
            try:
                await ws.send_json({'type': 'error', 'message': str(e)})
            except:
                pass

    def _eval_balance(self, state, angles):
        test = state.current_test()
        if state.current_test_idx != 0: return {}
        trunk = angles.get('trunk_tilt', 0) or 0
        if test['status'] == 'ready':
            test['status'] = 'running'
            test['start_time'] = time.time()
            return {'fms_status': 'started', 'message': '请闭上双眼，抬起单腿'}
        if test['status'] == 'running':
            duration = time.time() - test['start_time']
            # Detect balance break: sudden large trunk movement
            if trunk > 45 or abs(trunk - (test.get('prev_trunk', trunk))) > 20:
                if duration > 1.0:
                    test['status'] = 'done'
                    test['completed'] = True
                    test['data'] = {'duration': round(duration, 1)}
                    test['score'] = round(self.engine.score_balance(duration).score, 1)
                    return {'fms_status': 'completed', 'duration': round(duration, 1), 'score': test['score']}
            test['prev_trunk'] = trunk
            return {'fms_status': 'running', 'duration': round(duration, 1)}
        return {}

    def _eval_flexibility(self, state, angles):
        test = state.current_test()
        if test['status'] == 'ready':
            test['status'] = 'running'
            return {'fms_status': 'started', 'message': '请将双手举过头顶，下蹲至最低点保持'}
        knee_l = angles.get('left_knee', 180) or 180
        knee_r = angles.get('right_knee', 180) or 180
        trunk = angles.get('trunk_tilt', 0) or 0
        test['data'] = {'depth_angle': min(knee_l, knee_r), 'trunk_tilt': trunk, 'arm_maintained': 0.85}
        test['completed'] = True
        test['status'] = 'done'
        score = self.engine.score_flexibility(min(knee_l, knee_r), trunk, 0.85).score
        test['score'] = round(score, 1)
        return {'fms_status': 'completed', 'depth_angle': round(min(knee_l, knee_r), 1), 'trunk_tilt': round(trunk, 1), 'score': test['score']}

    def _eval_upper_limb(self, state, angles):
        test = state.current_test()
        if test['status'] == 'ready':
            test['status'] = 'running'
            return {'fms_status': 'started', 'message': '请将一只手从肩上、另一只手从腰后向背后靠拢'}
        # Approximate hand distance from shoulder-elbow angles
        l_shoulder = angles.get('left_shoulder', 90) or 90
        r_shoulder = angles.get('right_shoulder', 90) or 90
        est_distance = max(0, min(50, abs(l_shoulder - r_shoulder) * 0.8))
        test['data'] = {'hand_distance': round(est_distance, 1)}
        test['completed'] = True
        test['status'] = 'done'
        score = self.engine.score_upper_limb(est_distance).score
        test['score'] = round(score, 1)
        return {'fms_status': 'completed', 'hand_distance': round(est_distance, 1), 'score': test['score']}

    def _eval_core(self, state, angles):
        test = state.current_test()
        trunk = angles.get('trunk_tilt', 0) or 0
        if test['status'] == 'ready':
            test['status'] = 'running'
            test['start_time'] = time.time()
            return {'fms_status': 'started', 'message': '请保持平板支撑姿势'}
        if test['status'] == 'running':
            duration = time.time() - test['start_time']
            if duration >= 60:
                test['status'] = 'done'
                test['completed'] = True
                test['data'] = {'duration': 60}
                test['score'] = 100
                return {'fms_status': 'completed', 'duration': 60, 'score': 100}
            if trunk > 25:
                test['status'] = 'done'
                test['completed'] = True
                core_duration = max(5, min(60, duration - 1))
                test['data'] = {'duration': round(core_duration, 1)}
                test['score'] = round(self.engine.score_core(core_duration).score, 1)
                return {'fms_status': 'completed', 'duration': round(core_duration, 1), 'score': test['score']}
            return {'fms_status': 'running', 'duration': round(duration, 1)}
        return {}

    def _eval_symmetry(self, state, angles):
        test = state.current_test()
        if test['status'] == 'ready':
            test['status'] = 'running_left'
            return {'fms_status': 'started', 'message': '先做左侧弓步蹲，左腿在前'}
        if test['status'] == 'running_left':
            left_knee = angles.get('left_knee', 180) or 180
            if left_knee < 100:
                test['left_score'] = max(0, min(100, 100 - (100 - left_knee) * 0.5))
                test['status'] = 'running_right'
                return {'fms_status': 'step_complete', 'side': 'left', 'score': test['left_score'], 'message': '请做右侧弓步蹲，右腿在前'}
        elif test['status'] == 'running_right':
            right_knee = angles.get('right_knee', 180) or 180
            if right_knee < 100:
                test['right_score'] = max(0, min(100, 100 - (100 - right_knee) * 0.5))
                test['status'] = 'done'
                test['completed'] = True
                test['data'] = {'left_score': test['left_score'], 'right_score': test['right_score']}
                score = self.engine.score_symmetry(test['left_score'], test['right_score']).score
                test['score'] = round(score, 1)
                return {'fms_status': 'completed', 'left_score': test['left_score'], 'right_score': test['right_score'], 'score': test['score']}
        return {}

class FMSState:
    def __init__(self):
        self.current_test_idx = 0
        self.frame_count = 0
        self.last_angles = {}
        self.tests = [
            {'idx': 0, 'name': '闭眼单腿站立', 'instruction': '闭上双眼，抬起单腿，保持平衡', 'status': 'pending', 'start_time': 0, 'data': None, 'score': 0, 'completed': False},
            {'idx': 1, 'name': '徒手过头深蹲', 'instruction': '双手举过头顶，做深蹲至最低点', 'status': 'pending', 'start_time': 0, 'data': None, 'score': 0, 'completed': False},
            {'idx': 2, 'name': '肩关节活动度', 'instruction': '一手从肩上、一手从腰后向背后靠拢', 'status': 'pending', 'start_time': 0, 'data': None, 'score': 0, 'completed': False},
            {'idx': 3, 'name': '平板支撑', 'instruction': '保持平板支撑姿势，尽量坚持', 'status': 'pending', 'start_time': 0, 'data': None, 'score': 0, 'completed': False},
            {'idx': 4, 'name': '弓步蹲对称', 'instruction': '分别做左右弓步蹲', 'status': 'pending', 'start_time': 0, 'left_score': 0, 'right_score': 0, 'data': None, 'score': 0, 'completed': False},
        ]

    def current_test(self):
        if self.current_test_idx < len(self.tests):
            return self.tests[self.current_test_idx]
        return None

    def reset(self):
        self.__init__()
